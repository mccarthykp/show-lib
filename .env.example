# Copy this file to .env and set either a TMDB API Read Access Token or API key.
TMDB_READ_ACCESS_TOKEN=
TMDB_API_KEY=

# Docker host binding; change these when configuring Tailscale later.
# SHOWLIB_HOST_BIND=127.0.0.1
# SHOWLIB_PORT=8080

# Host database file: SHOWLIB_DATA_DIR/SHOWLIB_DB_FILENAME.
# Keep the directory mounted so SQLite journal files persist too.
# SHOWLIB_DATA_DIR=./data
# SHOWLIB_DB_FILENAME=showlib.sqlite
