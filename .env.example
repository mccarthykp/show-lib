# Set either a TMDB API Read Access Token or API key.
TMDB_READ_ACCESS_TOKEN=
TMDB_API_KEY=

# Persistent host database file: SHOWLIB_DATA_DIR/SHOWLIB_DB_FILENAME.
# Choose an absolute path to keep the data outside this checkout, or use ./data.
SHOWLIB_DATA_DIR=./data
SHOWLIB_DB_FILENAME=showlib.sqlite

# Local HTTP binding.
SHOWLIB_HOST_BIND=127.0.0.1
SHOWLIB_PORT=8080

# Run the container as the owner of the host database directory so backups do
# not require root. Set these from `id -u` and `id -g` when they are not 1000.
# SHOWLIB_UID=1000
# SHOWLIB_GID=1000
